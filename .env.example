# Local MySQL connection. Import tuition_fyp.sql into tuition_fyp first.
DATABASE_URI=mysql+mysqlconnector://root:YOUR_MYSQL_PASSWORD@localhost:3306/tuition_fyp
SECRET_KEY=replace-with-a-long-random-value

# Optional integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@tuitionapp.com

